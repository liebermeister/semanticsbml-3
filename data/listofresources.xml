          elements="species parameter"
	  idPattern="^\d+$"
	  />

<resource name="HMDB"
          uri="http://www.hmdb.ca/"
	  urn="hmdb"
	  action="http://www.hmdb.ca/metabolites/"
          elements="species parameter"
	  idPattern="^HMDB\d{5}$"
	  />

