<resource name="KEGG Pathway"
          uri="http://www.genome.jp/kegg/pathway/"
	  urn="kegg.pathway"
          location="http://www.genome.jp/kegg/pathway.html"
          action="http://www.genome.jp/dbget-bin/show_pathway?"
          elements="model assignmentRule rateRule algebraicRule reaction event"
          idPattern="^\w{2,3}\d{5}$"
          />

<resource name="KEGG Compound"
          uri="http://www.genome.jp/kegg/compound/"
	  urn="kegg.compound"
          location="http://www.genome.jp/kegg/ligand.html"
          action="http://www.genome.jp/dbget-bin/www_bget?cpd:"
          elements="species parameter"
          idInputHelper="C"
          idPattern="^C\d+$"
          />

<resource name="KEGG Reaction"
          uri="http://www.genome.jp/kegg/reaction/"
	  urn="kegg.reaction"
          location="http://www.genome.jp/kegg/ligand.html"
          action="http://www.genome.jp/dbget-bin/www_bget?rn:"
          elements="assignmentRule rateRule algebraicRule reaction event"
          idInputHelper="R"
          idPattern="^R\d+$"
          />

<resource name="PubMed"
	  uri="http://www.ncbi.nlm.nih.gov/PubMed/"
	  urn="pubmed"
	  alternateUris="http://www.pubmed.gov/"
          location="http://www.ncbi.nlm.nih.gov/PubMed/"
          action="http://www.ncbi.nlm.nih.gov/entrez/query.fcgi?cmd=Retrieve&amp;db=pubmed&amp;dopt=Abstract&amp;list_uids="
          elements="model"
          idPattern="^\d+$"
          />

<resource name="OMIM"
          uri="http://www.ncbi.nlm.nih.gov/OMIM/"
	  urn="omim"
          location="http://www.ncbi.nlm.nih.gov/entrez/query.fcgi?db=OMIM"
          action="http://www.ncbi.nih.gov/entrez/dispomim.cgi?id="
          elements="model species parameter"
          idPattern="^[*#+%^]?\d{6}$"
          />

<resource name="PIRSF"
          uri="http://pir.georgetown.edu/pirsf/"
	  urn="pirsf"
          location="http://pir.georgetown.edu/pirsf/"
          action="http://pir.georgetown.edu/cgi-bin/ipcSF?id="
          elements="species parameter"
          idInputHelper="SF"
          idPattern="^SF\d{6}$"
          />

<resource name="Taxonomy"
	  uri="http://www.ncbi.nlm.nih.gov/Taxonomy/"
	  urn="taxonomy"
	  alternateUris="http://www.taxonomy.org/"
          location="http://www.ebi.ac.uk/newt/display"
          action="http://www.ebi.ac.uk/newt/display?search="
          database="uk.ac.ebi.biomodels.TaxonomyDatabase"
          elements="model species parameter"
          idPattern="^\d+$"
	  />

  <!--action="http://www.ebi.ac.uk/compneur-srv/biomodels-main/search-models.do?cmd=ADVANCED:SEARCH&prs=&els=&rn0=Publication&rt0=&rn1=Publication&rt1=&rn2=Publication&rt2=&rn3=BIND&rt3=&rn4=BIND&rt4=&rn5=BIND&rt5=&lgc=and&bid="-->
<resource name="BioModels"
	  uri="http://www.ebi.ac.uk/biomodels/"
	  urn="biomodels.db"
          location="http://www.ebi.ac.uk/biomodels/"
          elements="model"
	  action="http://www.ebi.ac.uk/compneur-srv/biomodels-main/publ-model.do?mid="
	  idPattern="^(BIOMD)|(MODEL)\d{10}$"
	  />

<resource name="UniProt"
          uri="http://www.uniprot.org/"
	  urn="uniprot"
          location="http://www.uniprot.org/"
          action="http://www.ebi.uniprot.org/entry/"
          database="uk.ac.ebi.biomodels.UniProtDatabase"
          elements="species parameter"
          idPattern="^([OPQ][0-9][A-Z0-9][A-Z0-9][A-Z0-9][0-9](_[\dA-Z]{1,5})?)$"
          />
  <!-- idPattern is very unclear MIRIAM database vs. found somewhere vs. already annotated vs probably correct whats going on here-->
<resource name="Reactome"
          uri="http://www.reactome.org/"
	  urn="reactome"
          location="http://www.reactome.org/"
	  action="http://www.reactome.org/cgi-bin/link?SOURCE=Reactome&amp;ID="
          elements="species parameter model assignmentRule rateRule algebraicRule reaction event"
	  idPattern="^(REACT_\d+\.\d)|(\d+)|(REACT_\d+)|(REACT_\d+)$"
          />
<resource name="Saccharomyces genome database"
          uri="http://www.yeastgenome.org/"
	  urn="sgd"
          location="http://www.yeastgenome.org/"
          action="http://db.yeastgenome.org/cgi-bin/locus.pl?dbid="
          elements="species parameter"
          idPattern="^S\d{9}$"
	  />

</listOfResources>
