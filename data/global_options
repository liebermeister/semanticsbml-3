# TIde configuration file
[solver]
# copasi, c, scipy, soslib, limex, eulsim, radau, radau5, seulex, bestfortran
solvertype = copasi

[parallel]
# 0 or 1
use_parallel = 0

[external_tools]
# 0 or 1 <- only under Linux
use_nice = 0

[output]
# 0 or 1
write_pdfs = 0

[titration]
stepnumber = 100
minimum_titration_factor = 10e-15
starting_titration_factor = 10e-5
maximum_titration_factor = 10e-1
tolerated_relative_timecourse_difference = 1e-5

[storage]
tempfolder = /home/schulzma/tmp/
fortranfolder = /home/schulzma/semanticsbml/trunk/libTI2/fortran/
